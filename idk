-- ============================== ESP ==============================
local espMap = {}
local espDrawings = {}

local function newDrawing(class)
    local ok, d = pcall(Drawing.new, class)
    if ok and d then table.insert(espDrawings, d) end
    return ok and d or nil
end

local function cleanupDrawings()
    for _, d in ipairs(espDrawings) do pcall(function() d:Remove() end) end
    espDrawings = {}
    espMap = {}
end
onCleanup(cleanupDrawings)

local fovCircle = newDrawing("Circle")
if fovCircle then
    fovCircle.Thickness = 1
    fovCircle.Color = Color3.fromRGB(160, 120, 245)
    fovCircle.Transparency = 0.4
    fovCircle.Filled = false
    fovCircle.Visible = false
end

local function ensure(char)
    local e = espMap[char]
    if not e then
        e = {
            box = newDrawing("Square"),
            name = newDrawing("Text"),
            hpBack = newDrawing("Square"),
            hpFill = newDrawing("Square"),
            tracer = newDrawing("Line"),
            dist = newDrawing("Text"),
        }
        if e.name then
            e.name.Size = 13
            e.name.Center = true
            e.name.Outline = true
        end
        if e.dist then
            e.dist.Size = 12
            e.dist.Center = true
            e.dist.Outline = true
            e.dist.Color = Color3.fromRGB(230, 230, 230)
        end
        if e.hpFill then e.hpFill.Filled = true end
        espMap[char] = e
    end
    return e
end

local function hide(e)
    for _, d in pairs(e) do
        if d then d.Visible = false end
    end
end

local function renderESP()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local me = myChar()
    local myRoot = me and me:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position

    if fovCircle then
        if S.aimEnabled and S.fovCircle then
            fovCircle.Position = cam.ViewportSize * 0.5
            fovCircle.Radius = S.fov
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end
    end

    if not S.esp then
        for _, e in pairs(espMap) do hide(e) end
        return
    end

    local live = {}
    for _, char in ipairs(enemyChars()) do
        local head = char:FindFirstChild("Head")
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if head and root and hum then
            local headPos = head.Position + Vector3.new(0, 0.35, 0)
            local footPos = root.Position - Vector3.new(0, 3, 0)
            local dist = myPos and (root.Position - myPos).Magnitude or 0
            if dist <= S.espMaxDist then
                local hpTop, onTop = cam:WorldToViewportPoint(headPos)
                local hpBot, onBot = cam:WorldToViewportPoint(footPos)
                local e = ensure(char)
                live[char] = true
                if onTop or onBot then
                    local x1 = math.min(hpTop.X, hpBot.X)
                    local y1 = math.min(hpTop.Y, hpBot.Y)
                    local w = math.max(math.abs(hpTop.X - hpBot.X), 24)
                    local h = math.max(math.abs(hpBot.Y - hpTop.Y), 20)
                    if e.box then
                        e.box.Visible = S.espBox
                        e.box.Position = Vector2.new(x1, y1)
                        e.box.Size = Vector2.new(w, h)
                        e.box.Thickness = 1
                        e.box.Color = Color3.fromRGB(255, 80, 80)
                        e.box.Filled = false
                    end
                    if e.name then
                        e.name.Visible = S.espName
                        e.name.Position = Vector2.new(x1 + w / 2, y1 - 16)
                        e.name.Text = char.Name
                        e.name.Color = Color3.fromRGB(255, 255, 255)
                    end
                    if e.hpBack and e.hpFill then
                        local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        e.hpBack.Visible = S.espHealth
                        e.hpBack.Position = Vector2.new(x1 + w + 4, y1)
                        e.hpBack.Size = Vector2.new(3, h)
                        e.hpBack.Color = Color3.fromRGB(20, 20, 20)
                        e.hpBack.Filled = true
                        e.hpFill.Visible = S.espHealth
                        e.hpFill.Position = Vector2.new(x1 + w + 4, y1 + h * (1 - frac))
                        e.hpFill.Size = Vector2.new(3, h * frac)
                        e.hpFill.Color = Color3.fromRGB(80, 220, 110)
                    end
                    if e.tracer then
                        e.tracer.Visible = S.espTracer
                        e.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                        e.tracer.To = Vector2.new(x1 + w / 2, y1 + h)
                        e.tracer.Color = Color3.fromRGB(255, 80, 80)
                        e.tracer.Thickness = 1
                    end
                    if e.dist then
                        e.dist.Visible = S.espDist
                        e.dist.Position = Vector2.new(x1 + w / 2, y1 + h + 2)
                        e.dist.Text = string.format("%dm", math.floor(dist))
                    end
                else
                    hide(e)
                end
            else
                local e = espMap[char]
                if e then hide(e) end
            end
        end
    end
    for char, e in pairs(espMap) do
        if not live[char] then
            hide(e)
            if not char.Parent or not char:IsDescendantOf(workspace) then
                for _, d in pairs(e) do
                    if d then pcall(function() d:Remove() end) end
                end
                espMap[char] = nil
            end
        end
    end
end

connect(RunService.RenderStepped, function()

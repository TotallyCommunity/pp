-- ============================== AUTO BLOCK ==============================
local blockState = false
local blockAcc = 0

local function toolNow()
    local me = myChar()
    return me and me:FindFirstChildOfClass("Tool") or nil
end

local function sendBlock(on)
    if not WA then return end
    local tool = toolNow()
    if not tool then
        if on then return end
        if not blockState then return end
    end
    if on == blockState then return end
    local ok = pcall(function()
        WA:FireServer("Block", { tool = tool, on = on })
    end)
    if ok then blockState = on end
end

connect(RunService.Heartbeat, function(dt)
    if not alive() then return end
    blockAcc = blockAcc + dt
    if blockAcc < 0.1 then return end
    blockAcc = 0
    if not S.autoBlock then
        if blockState then sendBlock(false) end
        return
    end
    local me = myChar()
    local root = me and me:FindFirstChild("HumanoidRootPart")
    local tool = toolNow()
    if not me or not root or not tool or not MELEE_NAMES[tool.Name] then
        if blockState then sendBlock(false) end
        return
    end
    local want = false
    for _, char in ipairs(enemyChars()) do
        local croot = char:FindFirstChild("HumanoidRootPart")
        if croot and (croot.Position - root.Position).Magnitude <= S.blockRange then
            local chead = char:FindFirstChild("Head")
            if chead and visible(root.Position, chead.Position, char) then
                want = true
                break
            end
        end
    end
    sendBlock(want)
end)

-- ============================== AUTO RELOAD ==============================
local reloadAt = -math.huge

local function autoReloadStep()
    if not S.autoReload then return end
    local now = os.clock()
    if now - reloadAt < 1.2 then return end
    local tool = toolNow()
    if not tool then return end
    local ammo = tool:GetAttribute("Ammo")
    if type(ammo) == "number" and ammo <= 0 then
        reloadAt = now
        local vim = game:GetService("VirtualInputManager")
        local ok = pcall(function()
            vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)
        if not ok and WA then
            pcall(function() WA:FireServer("Reload", { tool = tool }) end)
        end
    end
end

connect(RunService.Heartbeat, function(dt)
    if not alive() then return end
    if not S.autoReload then return end
    autoReloadStep()
end)

-- ============================== SPEED ==============================
local speedApplied = false
connect(RunService.Heartbeat, function()
    if not alive() then return end
    local me = myChar()
    local root = me and me:FindFirstChild("HumanoidRootPart")
    if not root then
        speedApplied = false
        return
    end
    if S.speedOn then
        if root:GetAttribute("SSlide") \~= nil then return end
        local target = 21 * S.speedMult
        root:SetAttribute("SSpeed", target)
        speedApplied = true
    elseif speedApplied then
        root:SetAttribute("SSpeed", 21)
        speedApplied = false
    end
end)


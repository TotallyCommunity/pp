local MELEE_NAMES = {
    Fists = true, Sword = true, Axe = true, Spear = true, Dagger = true, Club = true,
    Shield = true, Gauntlets = true, Scythe = true, Katana = true, Hatchets = true,
}

local function myChar()
    local c = LP.Character
    if c and c.Parent then return c end
    return nil
end

local function enemyChars()
    local me = myChar()
    if not me then return {} end
    local myMatch = me:GetAttribute("MatchId")
    if type(myMatch) \~= "string" then myMatch = "" end
    local myTeam = me:GetAttribute("Team")
    local out, seen = {}, {}
    local function consider(c)
        if not c or c == me or seen[c] or not c:IsDescendantOf(workspace) then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        if not c:FindFirstChild("Head") then return end
        if S.teamCheck then
            if myMatch \~= "" then
                local m = c:GetAttribute("MatchId")
                if type(m) \~= "string" or m == "" or m \~= myMatch then return end
                if c:GetAttribute("Team") == myTeam then return end
            else
                local t = c:GetAttribute("Team")
                if t \~= nil and t == myTeam then return end
            end
        end
        seen[c] = true
        table.insert(out, c)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr \~= LP then consider(plr.Character) end
    end
    for _, tag in ipairs({ "Combatant", "Bot", "TrainingDummy" }) do
        for _, m in ipairs(game:GetService("CollectionService"):GetTagged(tag)) do
            if m:IsA("Model") then consider(m) end
        end
    end
    return out
end

local function rayParams(extraIgnore)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.IgnoreWater = true
    local list = {}
    local me = myChar()
    if me then table.insert(list, me) end
    for _, n in ipairs({ "FX", "Projectiles" }) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(list, f) end
    end
    if extraIgnore then
        for _, x in ipairs(extraIgnore) do table.insert(list, x) end
    end
    p.FilterDescendantsInstances = list
    return p
end

local function pointOf(char, mode, origin)
    local head = char:FindFirstChild("Head")
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
    if mode == "Head" and head then return head.Position + Vector3.new(0, 0.25, 0) end
    if mode == "Torso" and torso then return torso.Position end
    if mode == "Nearest" then
        local hp = head and (head.Position + Vector3.new(0, 0.25, 0)) or nil
        local tp = torso and torso.Position or nil
        if not hp then return tp end
        if not tp then return hp end
        if origin then
            return ((hp - origin).Magnitude <= (tp - origin).Magnitude) and hp or tp
        end
        return hp
    end
    return head and (head.Position + Vector3.new(0, 0.25, 0)) or (torso and torso.Position) or nil
end

local function visible(origin, point, char)
    local hit = workspace:Raycast(origin, point - origin, rayParams())
    return (not hit) or hit.Instance:IsDescendantOf(char)
end

local function pickRangedTarget(origin)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = cam.ViewportSize * 0.5
    local best, bestScore, bestPoint = nil, math.huge, nil
    for _, char in ipairs(enemyChars()) do
        local point = pointOf(char, S.hitpart, origin)
        if point then
            local sp, onScreen = cam:WorldToViewportPoint(point)
            if onScreen and sp.Z > 0 then
                local px = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if px <= S.fov and px < bestScore then
                    if not S.wallCheck or visible(origin, point, char) then
                        best, bestScore, bestPoint = char, px, point
                    end
                end
            end
        end
    end
    return best, bestPoint
end

local function meleeHitList()
    local me = myChar()
    if not me then return nil end
    local root = me:FindFirstChild("HumanoidRootPart")
    local head = me:FindFirstChild("Head")
    if not root or not head then return nil end
    local list, scored = {}, {}
    for _, char in ipairs(enemyChars()) do
        local croot = char:FindFirstChild("HumanoidRootPart")
        local chead = char:FindFirstChild("Head")
        if croot and chead then
            local dist = (croot.Position - root.Position).Magnitude
            if dist <= S.meleeRange then
                if not S.wallCheck or visible(head.Position, chead.Position, char) then
                    table.insert(scored, { model = char, dist = dist, point = chead.Position })
                end
            end
        end
    end
    table.sort(scored, function(a, b) return a.dist < b.dist end)
    for i = 1, math.min(#scored, math.max(1, S.maxTargets)) do
        table.insert(list, scored[i].model)
    end
    return list, scored[1] and scored[1].point or nil
end

-- ============================== REMOTE HOOK ==============================
local function handleFireServer(self, method, a1, a2)
    if self \~= WA then return end
    if a1 == "Shoot" and S.aimEnabled and type(a2) == "table" and typeof(a2.origin) == "Vector3" then
        local target, point = pickRangedTarget(a2.origin)
        if target and point then
            a2.dir = (point - a2.origin).Unit
        end
        return
    end
    if a1 == "Swing" and S.meleeSilent and type(a2) == "table" then
        local hits, nearest = meleeHitList()
        if hits and #hits > 0 then
            a2.hits = hits
            local me = myChar()
            if nearest and me then
                a2.dir = (nearest - me:GetPivot().Position).Unit
            end
        end
        return
    end
end

local function installHook()
    if not WA then return false end
    if RL and RL.namecallHook then
        RL.namecallHook("FireServer", function(self, method, ...)
            local a1, a2 = ...
            handleFireServer(self, method, a1, a2)
        end)
        S.hookLive = true
        return true
    end
    S.hookLive = false
    return false
end

if WA then
    installHook()
end


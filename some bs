        Size = UDim2.new(0, 50, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = tostring(Flags[Flag] or Default),
        TextColor3 = Theme.Primary,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = SliderFrame
    })
    
    local SliderBg = UI:CreateElement("Frame", {
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 15, 0, 40),
        Size = UDim2.new(1, -30, 0, 8),
        Parent = SliderFrame
    })
    
    UI:CreateCorner(SliderBg, 4)
    
    local SliderFill = UI:CreateElement("Frame", {
        BackgroundColor3 = Theme.Primary,
        BorderSizePixel = 0,
        Size = UDim2.new((Flags[Flag] or Default - Min) / (Max - Min), 0, 1, 0),
        Parent = SliderBg
    })
    
    UI:CreateCorner(SliderFill, 4)
    
    local SliderButton = UI:CreateElement("Frame", {
        BackgroundColor3 = Color3.white,
        BorderSizePixel = 0,
        Position = UDim2.new((Flags[Flag] or Default - Min) / (Max - Min), -8, 0.5, -8),
        Size = UDim2.new(0, 16, 0, 16),
        Parent = SliderBg
    })
    
    UI:CreateCorner(SliderButton, 8)
    UI:CreateStroke(SliderButton, Theme.Primary, 2, 0)
    
    local Dragging = false
    
    SliderBg.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
        end
    end)
    
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end)
    
    RunService.RenderStepped:Connect(function()
        if Dragging then
            local MouseX = Mouse.X
            local RelativeX = math.clamp(MouseX - SliderBg.AbsolutePosition.X, 0, SliderBg.AbsoluteSize.X)
            local Percentage = RelativeX / SliderBg.AbsoluteSize.X
            local Value = math.floor(Min + (Percentage * (Max - Min)) + 0.5)
            
            Flags[Flag] = Value
            ValueLabel.Text = tostring(Value)
            
            UI:Tween(SliderFill, {Size = UDim2.new(Percentage, 0, 1, 0)}, 0.1)
            UI:Tween(SliderButton, {Position = UDim2.new(Percentage, -8, 0.5, -8)}, 0.1)
            
            if Callback then
                Callback(Value)
            end
        end
    end)
    
    SliderFrame.MouseEnter:Connect(function()
        UI:Tween(SliderFrame, {BackgroundTransparency = 0.1}, 0.2)
    end)
    
    SliderFrame.MouseLeave:Connect(function()
        UI:Tween(SliderFrame, {BackgroundTransparency = 0.3}, 0.2)
    end)
    
    table.insert(Tab.Content, SliderFrame)
    return SliderFrame
end


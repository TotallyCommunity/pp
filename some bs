-- // QB Aimbot & Visuals Loop
task.spawn(function()
    while task.wait(0.1) do
        if Flags.QBAimbot then
            local ClosestPlayer = GetClosestPlayer()
            if ClosestPlayer and ClosestPlayer.Character then
                local Head = ClosestPlayer.Character:FindFirstChild("Head")
                if Head and HRP then
                    local Prediction = Head.Velocity * Vector3.new(1.35, 0, 1.35)
                    local HeadPosition = Head.Position + Prediction
                    local Distance = (HeadPosition - HRP.Position).Magnitude
                    
                    local Gravity = 196.2
                    local Angle = 45
                    local RadianAngle = math.rad(Angle)
                    local A = -0.5 * Gravity
                    local B = math.tan(RadianAngle) * 100
                    local C = -Distance
                    local Discriminant = (B ^ 2) - (4 * A * C)
                    
                    local Power
                    if Discriminant < 0 then
                        Power = math.sqrt((Distance * Gravity) / math.sin(2 * RadianAngle))
                    else
                        Power = (-B + math.sqrt(Discriminant)) / (2 * A)
                    end
                    
                    local PowerScale = 1 + (math.sqrt(Distance) / 1000)
                    Power = Power * PowerScale
                    Power = math.clamp(math.round(Power), 0, 100)
                    
                    local VerticalDistance
                    if Distance < 115 then
                        VerticalDistance = Distance * (math.sqrt(Distance) / 55)
                    else
                        VerticalDistance = Distance * (math.sqrt(Distance) / (55 / (Distance / 115)))
                    end
                    
                    QBData.Position = HeadPosition + Vector3.new(0, VerticalDistance, 0)
                    QBData.Power = Power
                    QBData.TargetPlayer = ClosestPlayer
                    
                    -- // Update Cards
                    if Flags.ShowCards then
                        CardsContainer.Visible = true
                        TargetCard.Value.Text = ClosestPlayer.Name
                        PowerCard.Value.Text = tostring(Power)
                        DistanceCard.Value.Text = tostring(math.floor(Distance)) .. " YDS"
                    else
                        CardsContainer.Visible = false
                    end
                    
                    -- // Create Beam
                    if Flags.BallBeam then
                        if HRP then
                            CreateBeam(HRP.Position, QBData.Position)
                        end
                    else
                        RemoveBeam()
                    end
                    
                    -- // Create Highlight
                    if Flags.PlayerHighlight then
                        CreateHighlight(ClosestPlayer.Character)
                    else
                        RemoveHighlight()
                    end
                else
                    RemoveBeam()
                    RemoveHighlight()
                    CardsContainer.Visible = false
                end
            else
                RemoveBeam()
                RemoveHighlight()
                CardsContainer.Visible = false
            end
        else
            RemoveBeam()
            RemoveHighlight()
            CardsContainer.Visible = false
        end
    end
end)


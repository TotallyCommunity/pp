-- // Tab Creation Function
function UI:CreateTab(Name, Icon, LayoutOrder)
    local TabData = {
        Name = Name,
        Content = {},
        Active = false
    }
    
    local TabButton = UI:CreateElement("TextButton", {
        BackgroundColor3 = Theme.Surface,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 42),
        LayoutOrder = LayoutOrder,
        Font = Enum.Font.GothamSemibold,
        Text = "",
        Parent = TabButtons
    })
    
    UI:CreateCorner(TabButton, 10)
    local TabStroke = UI:CreateStroke(TabButton, Theme.Border, 1, 0.7)
    
    local TabIcon = UI:CreateElement("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0.5, -10),
        Size = UDim2.new(0, 20, 0, 20),
        Font = Enum.Font.GothamBold,
        Text = Icon,
        TextColor3 = Theme.TextSecondary,
        TextSize = 16,
        Parent = TabButton
    })
    
    local TabLabel = UI:CreateElement("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 40, 0, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Font = Enum.Font.GothamSemibold,
        Text = Name,
        TextColor3 = Theme.TextSecondary,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = TabButton
    })
    
    TabButton.MouseEnter:Connect(function()
        if not TabData.Active then
            UI:Tween(TabButton, {BackgroundTransparency = 0.2}, 0.2)
            UI:Tween(TabLabel, {TextColor3 = Theme.TextPrimary}, 0.2)
            UI:Tween(TabIcon, {TextColor3 = Theme.Primary}, 0.2)
        end
    end)
    
    TabButton.MouseLeave:Connect(function()
        if not TabData.Active then
            UI:Tween(TabButton, {BackgroundTransparency = 0.4}, 0.2)
            UI:Tween(TabLabel, {TextColor3 = Theme.TextSecondary}, 0.2)
            UI:Tween(TabIcon, {TextColor3 = Theme.TextSecondary}, 0.2)
        end
    end)
    
    TabButton.MouseButton1Click:Connect(function()
        UI:SwitchTab(Name)
    end)
    
    TabData.Button = TabButton
    TabData.Label = TabLabel
    TabData.Icon = TabIcon
    TabData.Stroke = TabStroke
    
    Tabs[Name] = TabData
    
    return TabData
end

function UI:SwitchTab(TabName)
    for Name, Tab in next, Tabs do
        if Name == TabName then
            Tab.Active = true
            UI:Tween(Tab.Button, {BackgroundColor3 = Theme.Primary, BackgroundTransparency = 0}, 0.3)
            UI:Tween(Tab.Label, {TextColor3 = Color3.white}, 0.3)
            UI:Tween(Tab.Icon, {TextColor3 = Color3.white}, 0.3)
            UI:Tween(Tab.Stroke, {Color = Theme.Primary, Transparency = 0.3}, 0.3)
            
            for _, Element in next, Tab.Content do
                Element.Visible = true
            end
        else
            Tab.Active = false
            UI:Tween(Tab.Button, {BackgroundColor3 = Theme.Surface, BackgroundTransparency = 0.4}, 0.3)
            UI:Tween(Tab.Label, {TextColor3 = Theme.TextSecondary}, 0.3)
            UI:Tween(Tab.Icon, {TextColor3 = Theme.TextSecondary}, 0.3)
            UI:Tween(Tab.Stroke, {Color = Theme.Border, Transparency = 0.7}, 0.3)
            
            for _, Element in next, Tab.Content do
                Element.Visible = false
            end
        end
    end
    ActiveTab = TabName
end

